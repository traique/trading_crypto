# Thư mục dữ liệu (cache nến, sổ giao dịch, báo cáo). Mặc định ./data
CRYPTO_DATA_DIR=data

# Chi phí giả định cho backtest và tài khoản ảo (% mỗi lệnh khớp).
# Phí taker Binance mặc định 0.1%; trượt giá mặc định 0.1% ngược chiều người giao dịch.
CRYPTO_TAKER_FEE_PCT=0.1
CRYPTO_SLIPPAGE_PCT=0.1

# Nguồn dữ liệu (không cần key). api.binance.com bị chặn theo vùng (451): dùng bản sao data-api.
CRYPTO_BINANCE_DATA_URL=https://data-api.binance.vision
CRYPTO_OKX_URL=https://www.okx.com

# ─── Ứng dụng luôn bật (main_botkeep.py): trang web + Telegram + bot giao dịch ───
# Danh sách đầy đủ kèm giải thích: deploy/botkeep/.env.example và deploy/botkeep/README.md.
# Bot KHÔNG BAO GIỜ đặt lệnh lên sàn và không cần API key sàn.
WEB_PASSWORD=
PUBLIC_URL=
# IP reverse proxy được tin header X-Forwarded-For (chỉ đặt "*" khi trang web chỉ truy cập được qua proxy)
# TRUSTED_PROXY_IPS=127.0.0.1
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_REPORT_CHAT_IDS=
# paper | signal | off
TRADE_MODE=paper
# Chiến lược cho tín hiệu thật (tên trong bot/books.py): btc_sma_ens (mặc định), btc_trend, btc_buy_hold
SIGNAL_STRATEGY=btc_sma_ens
# Vốn mỗi tài khoản ảo (USDT)
PAPER_CAPITAL=10000
# Giờ chạy mỗi ngày (giờ Việt Nam, không sớm hơn 07:05)
TRADE_TIME=07:10
MAX_PENDING=10

# AI cho /phantich (ít nhất một key; thứ tự dự phòng theo PROVIDER_ORDER)
PROVIDER_ORDER=router9,groq,openrouter,xai
ROUTER9_BASE_URL=
ROUTER9_API_KEY=
ROUTER9_MODEL=gpt-4o-mini
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
# Thời gian chờ mỗi lượt gọi AI; nghỉ khi bị 429; nghỉ khi 9Router lỗi (giây)
LLM_CALL_TIMEOUT_SEC=120
LLM_QUOTA_COOLDOWN_SEC=300
ROUTER9_RETRY_SEC=900
# Chạy cryptotrader.graph trực tiếp (không qua bot): chiến lược quyết định hành động hệ thống.
# Bot bỏ qua biến này và dùng SIGNAL_STRATEGY.
# CRYPTO_ENGINE_STRATEGY=btc_sma_ens
# Ghi đè cấu hình agent: CRYPTO_AGENTS_<KHÓA> (xem cryptotrader/default_config.py)

# ─── Giới hạn gọi AI (tránh quá tải gateway 9Router) ───
# Mọi lượt gọi AI của cả tiến trình đi qua một cổng chung.
# Số lượt gọi chạy cùng lúc (1 = tuần tự, từng lượt một)
LLM_MAX_CONCURRENT=1
# Nghỉ giữa hai lượt gọi (giây, tính từ lúc lượt trước xong): ngẫu nhiên trong khoảng MIN..MAX
LLM_MIN_INTERVAL_SEC=10
LLM_MAX_INTERVAL_SEC=20
# Tối đa lượt gọi trong 60 giây / 1 giờ bất kỳ (vượt thì CHỜ, tối đa LLM_MAX_WAIT_SEC); 0 = không giới hạn
LLM_MAX_CALLS_PER_MINUTE=20
LLM_MAX_CALLS_PER_HOUR=0
LLM_MAX_WAIT_SEC=300
# Tối đa lượt gọi mỗi ngày (giờ VN) và mỗi lượt phân tích (vượt thì TỪ CHỐI: phân tích vẫn xong,
# dùng quyết định của hệ thống, ghi "AI không khả dụng"); 0 = không giới hạn
LLM_MAX_CALLS_PER_DAY=300
LLM_MAX_CALLS_PER_ANALYSIS=10
# lite = phân tích gọn ~9 lượt gọi (bỏ tranh luận bull/bear và nhóm rủi ro); full = bản đầy đủ 18-35 lượt
CRYPTO_AGENTS_PROFILE=lite

# ─── Futures long/short (USDⓈ-M perpetual) - tài khoản ảo + tín hiệu, KHÔNG đặt lệnh lên sàn ───
# paper = sổ ảo; signal = sổ ảo + vị thế mục tiêu cho tài khoản thật (báo số dư bằng /fvon); off = tắt
FUTURES_MODE=paper
# Cặp giao dịch (mỗi cặp một sổ ảo). Với 10 USDT: ETHUSDT được (lệnh tối thiểu 20 USDT → đòn bẩy x2-3),
# altcoin phần lớn tối thiểu 5 USDT; BTCUSDT KHÔNG được (tối thiểu 50 USDT → cần x5).
# Mỗi cặp một sổ ảo để theo dõi. Tín hiệu thật mặc định BNB: với 10 USDT, BNB là coin lớn duy nhất
# đạt lệnh tối thiểu (5 USDT) mà không bị ép đòn bẩy (ETH tối thiểu 20 USDT → bị ép x2-3). Xem README.
FUTURES_SYMBOLS=ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT
# Một hoặc nhiều cặp cho tín hiệu thật; nhiều cặp thì vốn chia đều (cần ≥ 300 USDT cho 4 coin lớn, xem
# research/ASSESSMENT.md). Vốn tối thiểu để chạy đúng cỡ: BNB 8, XRP 11, SOL 12, DOGE 14, ETH 43, BTC 72 USDT.
FUTURES_SIGNAL_SYMBOLS=BNBUSDT
# Chiến lược: v2 = bộ tham số đã tối ưu walk-forward (mặc định); v1 = bản đầu
FUTURES_RULE=v2
# Vốn mỗi sổ ảo, mục tiêu lợi nhuận (đạt thì đóng vị thế và dừng), mức dừng lỗ tổng (USDT)
FUTURES_CAPITAL=10
FUTURES_GOAL_PROFIT=100
FUTURES_STOP_EQUITY=5
# Giảm cỡ vị thế khi đang sụt giảm so với đỉnh: 0.3 = còn 25% cỡ khi sụt 30%. Cắt nửa sụt giảm và nửa lãi;
# vô tác dụng với vốn ~10 USDT (lệnh tối thiểu của sàn quyết định cỡ). 0 = tắt.
FUTURES_DD_SCALE=0
# Ghi đè tham số của chiến lược (để trống = theo FUTURES_RULE; v2: 0.3 và 2)
# FUTURES_TARGET_VOL=0.3
# FUTURES_MAX_LEVERAGE=2
# Đòn bẩy cao nhất chấp nhận để đạt lệnh tối thiểu của sàn (vốn nhỏ); vượt thì đứng ngoài
FUTURES_MIN_ORDER_LEVERAGE=3
# Funding giả định cho lệnh long ở sổ ảo (%/ngày); phí và trượt giá futures (% mỗi lệnh khớp)
FUTURES_FUNDING_PCT_DAY=0.03
CRYPTO_FUT_TAKER_FEE_PCT=0.05
CRYPTO_FUT_SLIPPAGE_PCT=0.05
