# ─── AI (chỉ dùng cho /phantich; /nhanh và bot giao dịch không cần AI) ───
# Thứ tự dự phòng: nhà cung cấp lỗi/hết quota thì chuyển sang nhà cung cấp kế tiếp.
# Nhà cung cấp chưa có key thì tự bỏ qua. Không có key nào: /phantich báo rõ là chưa dùng được.
PROVIDER_ORDER=router9,groq,openrouter,xai
ROUTER9_BASE_URL=https://your-9router.example.com/v1
ROUTER9_API_KEY=
ROUTER9_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Grok (xAI), tuỳ chọn
XAI_API_KEY=
XAI_MODEL=grok-4-fast
LLM_QUOTA_COOLDOWN_SEC=300
ROUTER9_RETRY_SEC=900
LLM_CALL_TIMEOUT_SEC=120

# ─── Telegram ───
TELEGRAM_TOKEN=
# Telegram id được phép dùng bot (gửi /id cho bot để biết id của bạn), cách nhau dấu phẩy
TELEGRAM_ALLOWED_IDS=
# Nơi gửi báo cáo tự động hằng ngày (bỏ trống = gửi cho TELEGRAM_ALLOWED_IDS; nhóm là số âm)
TELEGRAM_REPORT_CHAT_IDS=

# ─── Trang web ───
# Mật khẩu trang web (BẮT BUỘC: để trống thì trang web bị khoá, chỉ bot Telegram chạy).
# Trình duyệt hỏi tên đăng nhập + mật khẩu: tên gì cũng được, mật khẩu là giá trị này.
WEB_PASSWORD=
# Địa chỉ công khai của trang web, để bot gửi kèm link báo cáo (vd https://abc.botkeep.cloud)
PUBLIC_URL=
# IP của reverse proxy đứng trước trang web (ngăn cách bằng dấu phẩy), để khoá đăng nhập theo IP thật của
# người truy cập thay vì IP của proxy. Chỉ đặt "*" khi trang web CHỈ truy cập được qua proxy (như Botkeep).
# TRUSTED_PROXY_IPS=127.0.0.1
# Botkeep tự đặt SERVER_PORT; PORT dùng khi chạy nơi khác
# PORT=8080

# ─── Bot giao dịch (KHÔNG BAO GIỜ đặt lệnh lên sàn, không cần API key sàn) ───
# paper  = bot tự giao dịch trên các tài khoản ảo (mặc định; nên chạy vài tháng trước)
# signal = như paper + gửi lệnh đề xuất cho tài khoản thật; bạn tự đặt trên sàn rồi báo /khop
# off    = tắt bot giao dịch (vẫn dùng được /nhanh, /phantich)
TRADE_MODE=paper
# Chiến lược cho tín hiệu thật: btc_sma_ens (mặc định: BTC theo 7 đường SMA, đã kiểm định ngoài mẫu,
# xem README), hoặc btc_trend / btc_buy_hold (mốc so sánh). Chiến lược mới thêm vào bot/books.py
# sẽ dùng được tên của nó ở đây. /phantich cũng lấy hành động hệ thống từ chiến lược này.
SIGNAL_STRATEGY=btc_sma_ens
# Vốn mỗi tài khoản ảo (USDT)
PAPER_CAPITAL=10000
# Giờ bot chạy mỗi ngày (giờ Việt Nam). Nến ngày Binance đóng lúc 00:00 UTC = 07:00 giờ VN.
# Không bao giờ chạy trước 07:05 (nến chưa chốt): giá trị sớm hơn được nâng lên 07:05.
TRADE_TIME=07:10

# ─── Chi phí giả định cho tài khoản ảo (% mỗi lệnh khớp) ───
# Phí taker Binance mặc định 0.1% (chưa giảm BNB/VIP); trượt giá giả định 0.1% ngược chiều.
CRYPTO_TAKER_FEE_PCT=0.1
CRYPTO_SLIPPAGE_PCT=0.1

# ─── Nguồn dữ liệu (không cần key) ───
# api.binance.com bị chặn theo vùng (451): bot dùng bản sao dữ liệu công khai data-api.binance.vision, dự phòng OKX.
CRYPTO_BINANCE_DATA_URL=https://data-api.binance.vision
CRYPTO_OKX_URL=https://www.okx.com

# ─── Hàng đợi và tài nguyên ───
# Số lượt phân tích AI từ web/Telegram được chờ cùng lúc; yêu cầu trùng coin + ngày được gộp
MAX_PENDING=10
# Thư mục dữ liệu (cache nến, sổ giao dịch, báo cáo)
CRYPTO_DATA_DIR=data
# Số thư mục báo cáo AI giữ lại
KEEP_REPORTS=60

# ─── Giới hạn gọi AI (tránh quá tải gateway 9Router) ───
# Mọi lượt gọi AI của cả tiến trình đi qua một cổng chung. Một lượt /phantich ≈ 18-35 lượt gọi.
# Số lượt gọi chạy cùng lúc (1 = tuần tự, từng lượt một)
LLM_MAX_CONCURRENT=1
# Khoảng cách tối thiểu giữa hai lượt gọi (giây)
LLM_MIN_INTERVAL_SEC=1.5
# Tối đa lượt gọi trong 60 giây / 1 giờ bất kỳ (vượt thì CHỜ, tối đa LLM_MAX_WAIT_SEC); 0 = không giới hạn
LLM_MAX_CALLS_PER_MINUTE=20
LLM_MAX_CALLS_PER_HOUR=0
LLM_MAX_WAIT_SEC=300
# Tối đa lượt gọi mỗi ngày (giờ VN) và mỗi lượt phân tích (vượt thì TỪ CHỐI: phân tích vẫn xong,
# dùng quyết định của hệ thống, ghi "AI không khả dụng"); 0 = không giới hạn
LLM_MAX_CALLS_PER_DAY=300
LLM_MAX_CALLS_PER_ANALYSIS=60

# ─── Futures long/short (USDⓈ-M perpetual) - tài khoản ảo + tín hiệu, KHÔNG đặt lệnh lên sàn ───
# paper = sổ ảo; signal = sổ ảo + vị thế mục tiêu cho tài khoản thật (báo số dư bằng /fvon); off = tắt
FUTURES_MODE=paper
# Cặp giao dịch (mỗi cặp một sổ ảo). Với 10 USDT: ETHUSDT được (lệnh tối thiểu 20 USDT → đòn bẩy x2-3),
# BTCUSDT KHÔNG được (lệnh tối thiểu 100 USDT → cần x10).
FUTURES_SYMBOLS=ETHUSDT
FUTURES_SIGNAL_SYMBOL=ETHUSDT
# Vốn mỗi sổ ảo, mục tiêu lợi nhuận (đạt thì đóng vị thế và dừng), mức dừng lỗ tổng (USDT)
FUTURES_CAPITAL=10
FUTURES_GOAL_PROFIT=100
FUTURES_STOP_EQUITY=5
# Biến động mục tiêu của vị thế (0.5 = 50%/năm) và đòn bẩy tối đa của nó
FUTURES_TARGET_VOL=0.5
FUTURES_MAX_LEVERAGE=2
# Đòn bẩy cao nhất chấp nhận để đạt lệnh tối thiểu của sàn (vốn nhỏ); vượt thì đứng ngoài
FUTURES_MIN_ORDER_LEVERAGE=3
# Funding giả định cho lệnh long ở sổ ảo (%/ngày); phí và trượt giá futures (% mỗi lệnh khớp)
FUTURES_FUNDING_PCT_DAY=0.03
CRYPTO_FUT_TAKER_FEE_PCT=0.05
CRYPTO_FUT_SLIPPAGE_PCT=0.05
